{
  "name": "iocloud/laravel-sdk",
  "description": "Laravel SDK for managing IOCloud partner spaces",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-openssl": "*",
    "illuminate/console": "^10.0 || ^11.0 || ^12.0",
    "illuminate/http": "^10.0 || ^11.0 || ^12.0",
    "illuminate/routing": "^10.0 || ^11.0 || ^12.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "IOCloud\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IOCloud\\Laravel\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "IOCloud\\Laravel\\IOCloudServiceProvider"
      ],
      "aliases": {
        "IOCloud": "IOCloud\\Laravel\\Facades\\IOCloud"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/IbaaIbrahim/iocloud-sdk/issues",
    "source": "https://github.com/IbaaIbrahim/iocloud-laravel-sdk"
  }
}
