APP_NAME="Acme Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

LOG_CHANNEL=stack
LOG_LEVEL=debug

# No database is needed: the demo user directory lives in config/demo.php.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- IOCloud partner credentials -------------------------------------------
# Where the IOCloud Admin API is reachable, plus the partner client credentials
# used to register the identity provider and map tenants.
IOCLOUD_BASE_URL=http://127.0.0.1:8001
IOCLOUD_CLIENT_ID=
IOCLOUD_CLIENT_SECRET=
IOCLOUD_TIMEOUT=30

# --- IOCloud federation ----------------------------------------------------
# The public base URL IOCloud fetches this portal's JWKS from. It must match the
# registered issuer byte for byte — scheme, host, port, no trailing slash.
IOCLOUD_FEDERATION_ISSUER=http://127.0.0.1:8010
IOCLOUD_FEDERATION_AUDIENCE=ai-ecosystem

# Written by `php artisan iocloud:keys`. Defaults to
# storage/iocloud-federation-private.key; set an absolute path to move it, or set
# IOCLOUD_FEDERATION_PRIVATE_KEY to the PEM itself for secret-manager deployments.
# IOCLOUD_FEDERATION_PRIVATE_KEY_PATH=

# Subject tokens are exchanged immediately, so keep the lifetime short.
IOCLOUD_FEDERATION_TOKEN_TTL=300

# --- Demo wiring -----------------------------------------------------------
# The portal's own organisation id, and the IOCloud tenant it maps onto.
DEMO_EXTERNAL_TENANT_ID=acme-tenant-1
DEMO_IOCLOUD_TENANT_UUID=
DEMO_PROVIDER_NAME="Acme Portal (demo)"
DEMO_REQUIRE_EMAIL_VERIFIED=true
DEMO_ALLOW_JIT_USERS=true
